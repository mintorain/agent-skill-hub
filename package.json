{
  "name": "agent-skill-hub",
  "version": "0.1.0",
  "description": "GitHub의 AI 에이전트 정의를 Claude Skill로 변환·설치하는 플랫폼 (CLI + 로컬 웹 대시보드)",
  "type": "module",
  "bin": { "ash": "./dist/cli.js" },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "tsx src/cli.ts serve"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
